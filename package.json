{
  "name": "dms",
  "productName": "DMS",
  "version": "1.0.0",
  "description": "Modern, offline-first desktop document management system for corporate archives, correspondence and departments.",
  "author": "DMS",
  "license": "MIT",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "lint": "node --check main.js && node --check preload.js"
  },
  "dependencies": {
    "archiver": "^6.0.1",
    "dayjs": "^1.11.10",
    "electron-store": "^8.2.0",
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.2.0",
    "mammoth": "^1.7.2",
    "node-cron": "^3.0.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "qrcode": "^1.5.4",
    "realm": "^12.0.0",
    "sharp": "^0.33.0",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.dms.app",
    "productName": "DMS",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "activation.html",
      "assets/**/*",
      "pages/**/*",
      "services/**/*",
      "database/**/*",
      "electron/**/*",
      "utils/**/*",
      "config/**/*",
      "node_modules/**/*",
      "*.js",
      "*.html",
      "*.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "installerIcon": "installer-icon.ico",
      "uninstallerIcon": "installer-icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icons/icon.png"
    },
    "npmRebuild": true,
    "asar": true
  }
}